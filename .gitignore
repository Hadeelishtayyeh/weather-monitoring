## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Rider
.idea/

# VS Code
.vscode/

# Auto-generated files
Generated_Code/

# Packages
*.nupkg
*.snupkg
*.nuspec
packages/
# Optional: if using NuGet < 3
*.nupkg
project.lock.json
project.fragment.lock.json

# Other
*.log
*.tlog
*.cache
*.pidb
*.svclog
*.dbmdl
*.bak
*.orig

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
